        <mxCell id="pair" value="Paired counterfactual difference&#10;Δ = Dθ(candidate B) − Dθ(candidate A)&#10;residual measured against pair midpoint" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#b8dbc7;strokeColor=#4e8267;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="340" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nuisance" value="Separate nuisance explanations&#10;project out RGB constant / slow planes&#10;whiten with finite camera covariance&#10;large moves are not erased" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e3e5;strokeColor=#777d85;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="530" width="410" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="Separate tests for EACH difference&#10;whitened separation ≥ 3&#10;paired preference ≥ 2&#10;absolute fit RMS ≤ 4 noise units" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#b8dbc7;strokeColor=#4e8267;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="530" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="retain" value="Keep plausible whole candidates&#10;seed chooses one coherent graph&#10;position / topology / phase strengths&#10;never one universal confidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e99557;strokeColor=#9e572c;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="530" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="limit" value="Conservative finite-bank criterion, not a calibrated posterior&#10;Poor model fit → no evidence. Different factors are not conflated.&#10;An inference candidate is never selected using HR." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#355786;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="805" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeWidth=2;strokeColor=#4e8267;fontSize=14;fontFamily=Georgia;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="candidates" target="camera">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeWidth=2;strokeColor=#355786;fontSize=14;fontFamily=Georgia;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="camera" target="pair">
