        <mxCell id="out" value="Final SR&#10;plus decision diagnostics" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#355786;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
