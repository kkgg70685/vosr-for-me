          <mxGeometry x="60" y="365" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="SpatialVelocityAdapter&#10;[z, condition, LR, graph, time]&#10;zero-output convolution head&#10;bounded residual × object support" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efb9be;strokeColor=#9c646f;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="315" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="Revised velocity v + δv&#10;9 Euler updates&#10;frozen decoder → R" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efb9be;strokeColor=#9c646f;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="505" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="Acceptance for the ACTUAL composite&#10;1. intended relation improves&#10;2. paired RGB evidence supports it&#10;3. local + global LR error improves&#10;including the exterior seam" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#b8dbc7;strokeColor=#4e8267;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="315" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="copy" value="Copy R inside accepted object&#10;keep N inside rejected object&#10;blend only exterior background" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#b8dbc7;strokeColor=#4e8267;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="555" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="photo" value="Bounded coarse RGB lattice&#10;4 × 4 → bilinear field&#10;shared-camera line search&#10;no geometric or fine-frequency correction" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e3e5;strokeColor=#777d85;fontColor=#172236;fontFamily=Georgia;fontSize=18;arcSize=12;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="760" width="420" height="115" as="geometry" />
